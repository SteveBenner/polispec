#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -u
read_tools=(read notebookread read_file view grep search_file_content read_many_files view_image)
if [ "${1:-}" = "--read-tools" ]; then printf '%s\n' "${read_tools[@]}"; exit 0; fi
mode="${1:-pretool}"
[ "$#" -gt 0 ] && shift
harness="${POLISPEC_HARNESS:-claude}"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --harness) [ "$#" -ge 2 ] && harness="$2"; shift 2 || shift ;;
    *) shift ;;
  esac
done
[ "$harness" = claude-code ] && harness=claude
[ "$harness" = deepseek-tui ] && harness=deepseek
input="$(head -c 8388609 2>/dev/null || true)"
self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)"
state="${XDG_STATE_HOME:-$HOME/.local/state}/polispec"
if [ -n "${POLISPEC_STATE_HOME:-}" ] && [ ! -e /etc/polispec/active.json ]; then state="$POLISPEC_STATE_HOME"; fi
export POLISPEC_GUARD_PATH="$self_dir/polispec-guard"
skip() {
  key=""
  { IFS= read -r key || true; } < "$state/fastpath.txt"
  session=""
  if [[ $input =~ \"session_id\"[[:space:]]*:[[:space:]]*\"([^\"]*)\" ]]; then session="${BASH_REMATCH[1]}"; fi
  umask 077
  TZ=UTC printf '{"ts":"%(%Y-%m-%dT%H:%M:%SZ)T","tool":"%s","session":"%s","key":"%s","skip":"%s"}\n' -1 "$1" "$session" "$key" "$2" >> "$state/skips.jsonl" 2>/dev/null
  exit 0
}
if [ "$mode" = pretool ] && [ -f "$state/fastpath.txt" ] && [ -f "$state/fastpath.watch" ]; then
  fresh=1
  while IFS= read -r watched; do
    [ -n "$watched" ] || continue
    if [ ! -e "$watched" ] || [ "$watched" -nt "$state/fastpath.txt" ]; then fresh=0; break; fi
  done < "$state/fastpath.watch"
  [ -f "$state/fastpath.tools" ] || fresh=0
  tool=""
  if [[ $input =~ \"tool_name\"[[:space:]]*:[[:space:]]*\"([^\"]*)\" ]]; then tool="${BASH_REMATCH[1],,}"; fi
  first_tool=""
  if [ "$fresh" = 1 ]; then { IFS= read -r first_tool || true; } < "$state/fastpath.tools"; fi
  if [ "$fresh" = 1 ] && [ "$first_tool" != "*" ]; then
    if [ -z "$tool" ] || ! grep -qxF -- "$tool" "$state/fastpath.tools"; then fresh=0; fi
  fi
  if [ "$fresh" = 1 ]; then
    second=""
    { IFS= read -r _first && IFS= read -r second || true; } < "$state/fastpath.txt"
    [ -n "$second" ] || skip "$tool" no_needles
    printf '%s' "$input" | grep -qiF -f <(tail -n +2 "$state/fastpath.txt") || skip "$tool" no_match
  fi
fi
usable() {
  [ -n "$1" ] && [ -x "$1" ] && [ -f "$1" ] || return 1
  [ "$(cd "$(dirname "$1")" 2>/dev/null && pwd -P)" != "$self_dir" ]
}
bin=""
if [ -n "${POLISPEC_BIN:-}" ] && usable "$POLISPEC_BIN"; then bin="$POLISPEC_BIN"; fi
if [ -z "$bin" ]; then
  while IFS= read -r candidate; do
    if usable "$candidate"; then bin="$candidate"; break; fi
  done < <(type -ap polispec 2>/dev/null)
fi
if [ -z "$bin" ]; then
  for candidate in "${RPLUGIN_BIN_HOME:-$HOME/.local/bin}/polispec" "${RPLUGINS_HOME:-$HOME/.rplugins}/polispec/bin/polispec"; do
    if usable "$candidate"; then bin="$candidate"; break; fi
  done
fi
if [ -z "$bin" ]; then
  data_home="${POLISPEC_DATA_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/polispec}"
  if usable "$data_home/current/bin/polispec"; then bin="$data_home/current/bin/polispec"; fi
fi
if [ -z "$bin" ] && [ -f "$self_dir/polispec" ] && [ -x "$self_dir/polispec" ]; then bin="$self_dir/polispec"; fi
deadline="${POLISPEC_GUARD_DEADLINE:-8}"
case "$deadline" in [1-9]) ;; *) deadline=8 ;; esac
tool=""
if [[ $input =~ \"tool_name\"[[:space:]]*:[[:space:]]*\"([^\"]*)\" ]]; then tool="${BASH_REMATCH[1],,}"; fi
read_call=0
if [ "$mode" = pretool ]; then
  for name in "${read_tools[@]}"; do
    if [ "$tool" = "$name" ]; then read_call=1; break; fi
  done
fi
deny_unavailable() {
  decision=deny
  if [ "$mode" != pretool ] || [ "$read_call" = 1 ]; then decision=pass; fi
  session=""
  if [[ $input =~ \"session_id\"[[:space:]]*:[[:space:]]*\"([^\"]*)\" ]]; then session="${BASH_REMATCH[1]}"; fi
  safe_tool="${tool//[\\\"]/_}"
  safe_session="${session//[\\\"]/_}"
  safe_harness="${harness//[\\\"]/_}"
  umask 077
  TZ=UTC printf '{"ts":"%(%Y-%m-%dT%H:%M:%SZ)T","tool":"%s","session":"%s","harness":"%s","mode":"%s","cause":"%s","decision":"%s"}\n' -1 "$safe_tool" "$safe_session" "$safe_harness" "$mode" "$1" "$decision" >> "$state/launcher.jsonl" 2>/dev/null
  [ "$decision" = pass ] && exit 0
  case "$harness" in
    claude | codex)
      printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"[POLISPEC internal] guard unavailable; call denied. Run polispec doctor"}}'
      exit 0 ;;
    hermes)
      printf '%s\n' '{"action":"block","message":"[POLISPEC internal] guard unavailable; call denied. Run polispec doctor"}'
      exit 2 ;;
    antigravity)
      printf '%s\n' '{"decision":"deny","reason":"[POLISPEC internal] guard unavailable; call denied. Run polispec doctor"}'
      exit 0 ;;
    pi | deepseek)
      printf '%s\n' '{"decision":"block","reason":"[POLISPEC internal] guard unavailable; call denied. Run polispec doctor"}'
      exit 0 ;;
  esac
  echo "[POLISPEC internal] guard unavailable; call denied. Run polispec doctor" >&2
  exit 2
}
if [ -z "$bin" ]; then deny_unavailable no_binary; fi
case "$mode" in
  pretool | session) ;;
  *) exit 0 ;;
esac
launcher_note() {
  session=""
  if [[ $input =~ \"session_id\"[[:space:]]*:[[:space:]]*\"([^\"]*)\" ]]; then session="${BASH_REMATCH[1]}"; fi
  safe_tool="${tool//[\\\"]/_}"
  safe_session="${session//[\\\"]/_}"
  safe_harness="${harness//[\\\"]/_}"
  umask 077
  TZ=UTC printf '{"ts":"%(%Y-%m-%dT%H:%M:%SZ)T","tool":"%s","session":"%s","harness":"%s","mode":"%s","cause":"%s","decision":"pass"}\n' -1 "$safe_tool" "$safe_session" "$safe_harness" "$mode" "$1" >> "$state/launcher.jsonl" 2>/dev/null
}
judge_spawn() {
  stamp="$state/judge.spawn"
  last=0
  if [ -f "$stamp" ]; then { IFS= read -r last || true; } < "$stamp"; fi
  [[ $last =~ ^[0-9]+$ ]] || last=0
  [ $(( EPOCHSECONDS - last )) -ge 30 ] || return 0
  umask 077
  [ -d "$state" ] || mkdir -p -m 700 "$state" 2>/dev/null || return 0
  printf '%s\n' "$EPOCHSECONDS" > "$stamp" 2>/dev/null || return 0
  if command -v setsid >/dev/null 2>&1; then
    POLISPEC_JUDGE_RUNTIME="$bindir" setsid -f "$bin" judge serve </dev/null >/dev/null 2>&1
  else
    ( POLISPEC_JUDGE_RUNTIME="$bindir" "$bin" judge serve </dev/null >/dev/null 2>&1 & )
  fi
  return 0
}
judge_left() {
  now_us="${EPOCHREALTIME/./}"
  left_us=$(( judge_deadline - now_us ))
  [ "$left_us" -gt 0 ] || return 1
  printf -v rem '%d.%06d' $(( left_us / 1000000 )) $(( left_us % 1000000 ))
}
judge_extend() {
  [ "$judge_extended" = 0 ] || return 1
  extend_us=$(( judge_start + judge_wait * 1000000 ))
  [ "$extend_us" -gt "$judge_deadline" ] || return 1
  judge_deadline="$extend_us"
  judge_extended=1
}
judge_attempt() {
  jfile="$state/judge.json"
  if [ ! -r "$jfile" ]; then judge_cause=judge_absent; return 1; fi
  jtext=""
  { IFS= read -r -d '' jtext || true; } < "$jfile"
  if [[ $jtext =~ \"port\":([0-9]+) ]]; then jport="${BASH_REMATCH[1]}"; else judge_cause=judge_malformed; return 1; fi
  if [[ $jtext =~ \"token\":\"([0-9a-f]{32})\" ]]; then jtoken="${BASH_REMATCH[1]}"; else judge_cause=judge_malformed; return 1; fi
  budget="${POLISPEC_JUDGE_BUDGET:-0.5}"
  if [[ $budget =~ ^([0-9]+)(\.([0-9]{1,6}))?$ ]]; then
    frac="${BASH_REMATCH[3]}000000"
    budget_us=$(( 10#${BASH_REMATCH[1]} * 1000000 + 10#${frac:0:6} ))
  else
    budget_us=500000
  fi
  [ "$budget_us" -gt 0 ] || { judge_cause=judge_budget; return 1; }
  judge_start="${EPOCHREALTIME//[!0-9]/}"
  judge_deadline=$(( judge_start + budget_us ))
  judge_wait="${POLISPEC_JUDGE_WAIT-}"
  case "$judge_wait" in [0-8]) ;; *) judge_wait=6 ;; esac
  [ "$judge_wait" -lt "$deadline" ] || judge_wait=$(( deadline - 1 ))
  trap '' PIPE
  if ! { exec 3<>"/dev/tcp/127.0.0.1/$jport"; } 2>/dev/null; then judge_cause=judge_refused; return 1; fi
  payload_bytes="${#input}"
  if ! printf '%s\n%s' "POLISPEC/1 $jtoken $mode $harness $bindir caller=$$ $payload_bytes" "$input" >&3 2>/dev/null; then exec 3>&-; judge_cause=judge_refused; return 1; fi
  jhead=""
  if ! judge_left; then exec 3>&-; judge_cause=judge_timeout; return 1; fi
  IFS= read -t "$rem" -r -u 3 jhead
  jrc=$?
  if [ "$jrc" -gt 128 ] && judge_extend; then
    jpart="$jhead"
    jhead=""
    if judge_left; then IFS= read -t "$rem" -r -u 3 jhead; jrc=$?; else jrc=142; fi
    jhead="$jpart$jhead"
  fi
  if [ "$jrc" -ne 0 ]; then
    exec 3>&-
    judge_cause=judge_timeout
    return 1
  fi
  if ! [[ $jhead =~ ^POLISPEC/1\ (stale|busy|error|[0-9]+)\ ([0-9]+)$ ]]; then exec 3>&-; judge_cause=judge_malformed; return 1; fi
  jstatus="${BASH_REMATCH[1]}"
  jlen="${BASH_REMATCH[2]}"
  jbody=""
  if [ "$jlen" -gt 0 ] && [ "$jstatus" != stale ] && [ "$jstatus" != busy ] && [ "$jstatus" != error ]; then
    if ! judge_left || ! read -t "$rem" -r -N "$jlen" -u 3 jbody; then exec 3>&-; judge_cause=judge_timeout; return 1; fi
  fi
  exec 3>&-
  case "$jstatus" in
    stale | busy | error) judge_cause="judge_$jstatus"; return 1 ;;
  esac
  jbody="${jbody%"${jbody##*[!$'\n']}"}"
  if [ "$jstatus" = 0 ]; then
    if [ "$judge_extended" = 1 ]; then launcher_note judge_slow; fi
    [ -n "$jbody" ] && printf '%s\n' "$jbody"
    exit 0
  fi
  if [ "$jstatus" = 2 ] && [ "$mode" = pretool ] && [ "${jbody:0:1}" = "{" ]; then
    if [ "$judge_extended" = 1 ]; then launcher_note judge_slow; fi
    printf '%s\n' "$jbody"
    exit 2
  fi
  judge_cause="judge_exit_$jstatus"
  return 1
}
if [ "${POLISPEC_JUDGE:-on}" != off ]; then
  resolved="$(readlink -f -- "$bin" 2>/dev/null)" || resolved=""
  [ -n "$resolved" ] || resolved="$bin"
  bindir="$(cd "$(dirname "$resolved")" 2>/dev/null && pwd -P)"
  saved_lc="${LC_ALL-}"
  saved_lc_set="${LC_ALL+x}"
  LC_ALL=C
  judge_cause=""
  judge_extended=0
  judge_start=0
  if ! judge_attempt; then
    if [ "$judge_extended" = 1 ]; then
      deadline=$(( deadline - ( ${EPOCHREALTIME//[!0-9]/} - judge_start + 999999 ) / 1000000 ))
      [ "$deadline" -ge 1 ] || deadline=1
    fi
    if [ -n "$saved_lc_set" ]; then LC_ALL="$saved_lc"; else unset LC_ALL; fi
    trap - PIPE
    launcher_note "$judge_cause"
    case "$judge_cause" in judge_absent | judge_refused | judge_stale) judge_spawn ;; esac
  fi
fi
if command -v timeout >/dev/null 2>&1; then
  out="$(printf '%s' "$input" | timeout -k 1 "$deadline" "$bin" hook "$mode" --harness "$harness" 2>/dev/null)"
  rc=$?
else
  out="$(
    set -m
    "$bin" hook "$mode" --harness "$harness" 2>/dev/null < <(printf '%s' "$input") &
    hp=$!
    { sleep "$deadline"; kill -9 -- "-$hp" "$hp"; } >/dev/null 2>&1 &
    wp=$!
    wait "$hp"
    hrc=$?
    kill "$wp" >/dev/null 2>&1
    exit "$hrc"
  )"
  rc=$?
fi
if [ "$rc" -eq 2 ] && [ "$mode" = pretool ] && [ "${out:0:1}" = "{" ]; then
  printf '%s\n' "$out"
  exit 2
fi
case "$rc" in
  0) ;;
  124 | 137 | 143) deny_unavailable timeout ;;
  *) deny_unavailable "exit_$rc" ;;
esac
[ -n "$out" ] && printf '%s\n' "$out"
exit 0
