#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -u
read_tools=(read notebookread read_file view grep search_file_content read_many_files view_image)
if [ "${1:-}" = "--read-tools" ]; then printf '%s\n' "${read_tools[@]}"; exit 0; fi
mode="${1:-pretool}"
[ "$#" -gt 0 ] && shift
harness="${POLISPEC_HARNESS:-claude}"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --harness) [ "$#" -ge 2 ] && harness="$2"; shift 2 || shift ;;
    *) shift ;;
  esac
done
[ "$harness" = claude-code ] && harness=claude
[ "$harness" = deepseek-tui ] && harness=deepseek
input="$(head -c 8388609 2>/dev/null || true)"
self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)"
state="${XDG_STATE_HOME:-$HOME/.local/state}/polispec"
if [ -n "${POLISPEC_STATE_HOME:-}" ] && [ ! -e /etc/polispec/active.json ]; then state="$POLISPEC_STATE_HOME"; fi
export POLISPEC_GUARD_PATH="$self_dir/polispec-guard"
skip() {
  key=""
  { IFS= read -r key || true; } < "$state/fastpath.txt"
  session=""
  if [[ $input =~ \"session_id\"[[:space:]]*:[[:space:]]*\"([^\"]*)\" ]]; then session="${BASH_REMATCH[1]}"; fi
  umask 077
  TZ=UTC printf '{"ts":"%(%Y-%m-%dT%H:%M:%SZ)T","tool":"%s","session":"%s","key":"%s","skip":"%s"}\n' -1 "$1" "$session" "$key" "$2" >> "$state/skips.jsonl" 2>/dev/null
  exit 0
}
if [ "$mode" = pretool ] && [ -f "$state/fastpath.txt" ] && [ -f "$state/fastpath.watch" ]; then
  fresh=1
  while IFS= read -r watched; do
    [ -n "$watched" ] || continue
    if [ ! -e "$watched" ] || [ "$watched" -nt "$state/fastpath.txt" ]; then fresh=0; break; fi
  done < "$state/fastpath.watch"
  [ -f "$state/fastpath.tools" ] || fresh=0
  tool=""
  if [[ $input =~ \"tool_name\"[[:space:]]*:[[:space:]]*\"([^\"]*)\" ]]; then tool="${BASH_REMATCH[1],,}"; fi
  first_tool=""
  if [ "$fresh" = 1 ]; then { IFS= read -r first_tool || true; } < "$state/fastpath.tools"; fi
  if [ "$fresh" = 1 ] && [ "$first_tool" != "*" ]; then
    if [ -z "$tool" ] || ! grep -qxF -- "$tool" "$state/fastpath.tools"; then fresh=0; fi
  fi
  if [ "$fresh" = 1 ]; then
    second=""
    { IFS= read -r _first && IFS= read -r second || true; } < "$state/fastpath.txt"
    [ -n "$second" ] || skip "$tool" no_needles
    printf '%s' "$input" | grep -qiF -f <(tail -n +2 "$state/fastpath.txt") || skip "$tool" no_match
  fi
fi
usable() {
  [ -n "$1" ] && [ -x "$1" ] && [ -f "$1" ] || return 1
  [ "$(cd "$(dirname "$1")" 2>/dev/null && pwd -P)" != "$self_dir" ]
}
bin=""
if [ -n "${POLISPEC_BIN:-}" ] && usable "$POLISPEC_BIN"; then bin="$POLISPEC_BIN"; fi
if [ -z "$bin" ]; then
  while IFS= read -r candidate; do
    if usable "$candidate"; then bin="$candidate"; break; fi
  done < <(type -ap polispec 2>/dev/null)
fi
if [ -z "$bin" ]; then
  for candidate in "${RPLUGIN_BIN_HOME:-$HOME/.local/bin}/polispec" "${RPLUGINS_HOME:-$HOME/.rplugins}/polispec/bin/polispec"; do
    if usable "$candidate"; then bin="$candidate"; break; fi
  done
fi
if [ -z "$bin" ]; then
  data_home="${POLISPEC_DATA_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/polispec}"
  if usable "$data_home/current/bin/polispec"; then bin="$data_home/current/bin/polispec"; fi
fi
if [ -z "$bin" ] && [ -f "$self_dir/polispec" ] && [ -x "$self_dir/polispec" ]; then bin="$self_dir/polispec"; fi
deadline="${POLISPEC_GUARD_DEADLINE:-8}"
case "$deadline" in [1-9]) ;; *) deadline=8 ;; esac
tool=""
if [[ $input =~ \"tool_name\"[[:space:]]*:[[:space:]]*\"([^\"]*)\" ]]; then tool="${BASH_REMATCH[1],,}"; fi
read_call=0
if [ "$mode" = pretool ]; then
  for name in "${read_tools[@]}"; do
    if [ "$tool" = "$name" ]; then read_call=1; break; fi
  done
fi
deny_unavailable() {
  decision=deny
  if [ "$mode" != pretool ] || [ "$read_call" = 1 ]; then decision=pass; fi
  session=""
  if [[ $input =~ \"session_id\"[[:space:]]*:[[:space:]]*\"([^\"]*)\" ]]; then session="${BASH_REMATCH[1]}"; fi
  safe_tool="${tool//[\\\"]/_}"
  safe_session="${session//[\\\"]/_}"
  safe_harness="${harness//[\\\"]/_}"
  umask 077
  TZ=UTC printf '{"ts":"%(%Y-%m-%dT%H:%M:%SZ)T","tool":"%s","session":"%s","harness":"%s","mode":"%s","cause":"%s","decision":"%s"}\n' -1 "$safe_tool" "$safe_session" "$safe_harness" "$mode" "$1" "$decision" >> "$state/launcher.jsonl" 2>/dev/null
  [ "$decision" = pass ] && exit 0
  case "$harness" in
    claude | codex)
      printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"[POLISPEC internal] guard unavailable; call denied."}}'
      exit 0 ;;
    hermes)
      printf '%s\n' '{"action":"block","message":"[POLISPEC internal] guard unavailable; call denied."}'
      exit 2 ;;
    antigravity)
      printf '%s\n' '{"decision":"deny","reason":"[POLISPEC internal] guard unavailable; call denied."}'
      exit 0 ;;
    pi | deepseek)
      printf '%s\n' '{"decision":"block","reason":"[POLISPEC internal] guard unavailable; call denied."}'
      exit 0 ;;
  esac
  echo "[POLISPEC internal] guard unavailable; call denied." >&2
  exit 2
}
if [ -z "$bin" ]; then deny_unavailable no_binary; fi
case "$mode" in
  pretool | session) ;;
  *) exit 0 ;;
esac
if command -v timeout >/dev/null 2>&1; then
  out="$(printf '%s' "$input" | timeout -k 1 "$deadline" "$bin" hook "$mode" --harness "$harness" 2>/dev/null)"
  rc=$?
else
  out="$(
    set -m
    "$bin" hook "$mode" --harness "$harness" 2>/dev/null < <(printf '%s' "$input") &
    hp=$!
    { sleep "$deadline"; kill -9 -- "-$hp" "$hp"; } >/dev/null 2>&1 &
    wp=$!
    wait "$hp"
    hrc=$?
    kill "$wp" >/dev/null 2>&1
    exit "$hrc"
  )"
  rc=$?
fi
if [ "$rc" -eq 2 ] && [ "$mode" = pretool ] && [ "${out:0:1}" = "{" ]; then
  printf '%s\n' "$out"
  exit 2
fi
case "$rc" in
  0) ;;
  124 | 137 | 143) deny_unavailable timeout ;;
  *) deny_unavailable "exit_$rc" ;;
esac
[ -n "$out" ] && printf '%s\n' "$out"
exit 0
